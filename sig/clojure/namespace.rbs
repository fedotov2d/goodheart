module Clojure
  class Namespace < Hash[untyped, untyped]
    SPECIAL: Array[String]
    LITERALS: Hash[String, bool?]

    def initialize: (Runtime runtime) -> void

    attr_reader runtime: Runtime

    def evaluate: (untyped form) -> untyped

    private

    def resolve: (String symbol) -> untyped

    def lookup: (String symbol, String? name, String? ns_name) -> untyped

    def form_eval: (Array[untyped] form) -> untyped
  end
end
