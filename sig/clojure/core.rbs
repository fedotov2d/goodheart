module Clojure
  # Built-ins live in the library hash, not as Ruby methods.
  # Call them as Core["name"][context, arguments].
  class Core
    extend Library

    @gensym_counter: Integer?

    def self.next_gensym: (?String prefix) -> String

    def self.syntax_quote: (Namespace ctx, untyped form, Hash[String, String] gensyms) -> untyped

    def self.syntax_quote_symbol: (String symbol, Hash[String, String] gensyms) -> String

    def self.syntax_quote_array: (Namespace ctx, Array[untyped] form, Hash[String, String] gensyms) -> untyped

    def self.syntax_quote_list: (Namespace ctx, Array[untyped] list, Hash[String, String] gensyms) -> Array[untyped]

    def self.macroexpand_once: (Namespace ctx, untyped form) -> untyped

    def self.macroexpand_all: (Namespace ctx, untyped form) -> untyped

    def self.thread_first_step: (untyped acc, untyped form) -> Array[untyped]

    def self.thread_last_step: (untyped acc, untyped form) -> Array[untyped]

    def self.parse_fn: (Array[untyped] args) -> [String?, Array[untyped]]

    def self.vector_form?: (untyped form) -> bool

    def self.parse_arity: (Array[untyped] clause) -> [Array[untyped], String?, Array[untyped]]

    def self.split_params: (Array[untyped] raw_params) -> [Array[untyped], String?]

    def self.match_arity: (Array[untyped] arities, Integer arg_count) -> untyped

    def self.invoke_fn: (Namespace ctx, String? fn_name, function fn_proc, Array[untyped] arities, Array[untyped] fn_args) -> untyped

    def self.bind_fn_context: (Namespace ctx, String? fn_name, function fn_proc, Array[untyped] arity, Array[untyped] fn_args) -> Namespace
  end
end
